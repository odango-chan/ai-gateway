  "cards": [
    {
      "dot": "rose",
      "title": "共享账号边界",
      "items": [
        "Provider API Key 只在 Gateway 主机上通过环境变量展开。",
        "客户端不保存 Provider Key，所有客户端共享同一上游账号额度。",
        "Gateway 注入 Authorization，并移除 X-Gateway-Token 与 Proxy-Authorization。"
      ]
    },
    {
      "dot": "amber",
      "title": "两种凭证",
      "items": [
        "Provider API Key：Gateway 访问上游模型服务的凭证。",
        "Gateway Access Token：远程客户端访问内网 Gateway 的共享令牌。",
        "非回环监听必须同时启用 allow_remote 与 access_token_env；它不是用户认证系统。"
      ]
    },
    {
      "dot": "cyan",
      "title": "请求与流式响应",
      "items": [
        "请求路径为 /{label}/{upstream-path}，标签来自静态配置，剩余路径拼接到 base_url。",
        "请求体上限 16 MiB，最多 16 个并发代理请求，超限分别返回 413 与 503。",
        "SSE 响应由 ReverseProxy 边转发边 Flush，不缓冲完整响应。"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行边界",
      "items": [
        "默认监听 127.0.0.1:8787；GET /healthz 不经过路由与令牌校验。",
        "SIGTERM 触发优雅关闭，默认 10 秒超时。",
        "没有数据库、用户体系、OAuth、RBAC、多租户、重试、负载均衡或协议转换。"
      ]
    }
  ]
